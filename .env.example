# =============================================================
# FORENZA — Environment Variable Template
# Copy this file to web/.env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# =============================================================

# -------------------------------------------------------------
# SUPABASE (Web / API)
# Get these from: https://supabase.com/dashboard → Project → Settings → API
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Supabase JWT secret (Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# -------------------------------------------------------------
# APPLICATION
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FORENZA
NEXT_PUBLIC_APP_VERSION=1.0.0

# Internal secret for QR token signing (min 32 chars, random)
# Generate: openssl rand -base64 32
FORENZA_QR_JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_32_BYTES_AT_LEAST

# Internal secret for handover token signing (min 32 chars, random)
FORENZA_HANDOVER_JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_32_BYTES_AT_LEAST

# Token TTLs (seconds)
FORENZA_QR_TOKEN_TTL_SECONDS=86400
FORENZA_HANDOVER_TOKEN_TTL_SECONDS=900

# -------------------------------------------------------------
# FZ-AI MULTI-MODEL ORCHESTRATOR
# -------------------------------------------------------------
AI_PRIMARY_PROVIDER=nvidia
AI_FALLBACK_PROVIDER=gemini

# NVIDIA NIM Integration (OpenAI-compatible)
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Specialized Model Identifiers
NVIDIA_REASONING_MODEL=deepseek-ai/deepseek-r1
NVIDIA_VISION_MODEL=nvidia/neva-22b
NVIDIA_OCR_MODEL=nvidia/nemotron-ocr
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_FAST_MODEL=nvidia/nemotron-4-340b-instruct
NVIDIA_TRANSLATION_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_SAFETY_MODEL=nvidia/llama-3.1-nemoguard-8b-content-safety

# Google Gemini API (Fallback / Multimodal Cross-Checker)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# Execution Boundaries
AI_TIMEOUT_MS=15000
AI_MAX_REQUEST_SIZE=52428800

# Optional local ONNX service fallback
FORENZA_AI_SERVICE_URL=http://localhost:8000
FORENZA_AI_SERVICE_API_KEY=CHANGE_ME_AI_SERVICE_INTERNAL_KEY_AT_LEAST_32_CHARS
AI_MODEL_PATH=./models/efficientnet_b0.onnx
AI_CONFIDENCE_THRESHOLD=0.50

# -------------------------------------------------------------
# GEOFENCE
# Default allowed radius in meters (spec: 500m)
# -------------------------------------------------------------
GEOFENCE_DEFAULT_RADIUS_METERS=500

# -------------------------------------------------------------
# STORAGE
# Signed URL TTL in seconds (spec: 60s)
# Storage bucket names (must match Supabase Storage setup)
# -------------------------------------------------------------
STORAGE_SIGNED_URL_TTL_SECONDS=60
SUPABASE_BUCKET_EVIDENCE_MEDIA=evidence-media
SUPABASE_BUCKET_LAB_REPORTS=lab-reports
SUPABASE_BUCKET_DOSSIERS=court-dossiers

# -------------------------------------------------------------
# RATE LIMITING (in-memory MVP — use Redis/Upstash in production)
# -------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SECONDS=60

# -------------------------------------------------------------
# SENTRY (Error Monitoring)
# Get DSN from: https://sentry.io → Project → Settings → SDK Setup
# -------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_ORG=YOUR_SENTRY_ORG
SENTRY_PROJECT=forenza-web
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN

# -------------------------------------------------------------
# MAP TILES
# MapLibre GL with free OpenFreeMap tiles (no key required)
# OR provide a MapTiler key for satellite/premium tiles
# -------------------------------------------------------------
NEXT_PUBLIC_MAPTILER_KEY=optional_maptiler_api_key

# -------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY
# (Supabase local dev — from: supabase start)
# -------------------------------------------------------------
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
