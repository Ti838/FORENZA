# =============================================================
# FORENZA — Environment Variable Template
# Copy this file to .env.local (web/) and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# =============================================================

# -------------------------------------------------------------
# SUPABASE (Web / API)
# Get these from: https://supabase.com/dashboard → Project → Settings → API
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Supabase JWT secret (Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# -------------------------------------------------------------
# APPLICATION
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FORENZA
NEXT_PUBLIC_APP_VERSION=1.0.0

# Internal secret for QR token signing (min 32 chars, random)
QR_TOKEN_SECRET=CHANGE_ME_USE_OPENSSL_RAND_32_BYTES

# Internal secret for handover token signing (min 32 chars, random)
HANDOVER_TOKEN_SECRET=CHANGE_ME_USE_OPENSSL_RAND_32_BYTES

# Token TTLs
QR_TOKEN_TTL_SECONDS=86400
HANDOVER_TOKEN_TTL_SECONDS=900

# -------------------------------------------------------------
# AI CLASSIFICATION SERVICE
# -------------------------------------------------------------
# URL of the FastAPI AI service
AI_SERVICE_URL=http://localhost:8000
# Internal auth token for AI service (min 32 chars, random)
AI_SERVICE_API_KEY=CHANGE_ME_AI_SERVICE_INTERNAL_KEY

# Model configuration
AI_MODEL_PATH=./models/efficientnet_b0.onnx
AI_CONFIDENCE_THRESHOLD=0.50

# -------------------------------------------------------------
# GEOFENCE
# -------------------------------------------------------------
# Default allowed radius in meters (spec: 500m)
GEOFENCE_DEFAULT_RADIUS_METERS=500

# -------------------------------------------------------------
# STORAGE
# -------------------------------------------------------------
# Signed URL TTL in seconds (spec: 60s)
STORAGE_SIGNED_URL_TTL_SECONDS=60

# Storage bucket names (must match Supabase Storage setup)
SUPABASE_BUCKET_EVIDENCE_MEDIA=evidence-media
SUPABASE_BUCKET_LAB_REPORTS=lab-reports
SUPABASE_BUCKET_DOSSIERS=court-dossiers

# -------------------------------------------------------------
# RATE LIMITING
# -------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SECONDS=60

# -------------------------------------------------------------
# SENTRY (Error Monitoring)
# Get DSN from: https://sentry.io → Project → Settings → SDK Setup
# -------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_ORG=YOUR_SENTRY_ORG
SENTRY_PROJECT=forenza-web
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN

# -------------------------------------------------------------
# MAP
# MapLibre GL uses OpenFreeMap or self-hosted tiles (no API key required by default)
# OR provide a MapTiler/Mapbox key for satellite tiles
# -------------------------------------------------------------
NEXT_PUBLIC_MAPTILER_KEY=optional_maptiler_api_key

# -------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY
# (Supabase local dev — from: supabase start)
# These are automatically set by Supabase CLI; override only if needed
# -------------------------------------------------------------
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
